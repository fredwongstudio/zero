# Server only. Never prefix this secret with NEXT_PUBLIC_.
ELEVENLABS_API_KEY=
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Optional local-only shortcut: use an unauthenticated/public ElevenLabs agent.
# Ignored in production; production always uses the server token route.
ZERO_PUBLIC_AGENT=false

# Enables /?preview=1 scripted visual preview in development only.
# Preview never requests a microphone or calls ElevenLabs.
ZERO_ENABLE_PREVIEW=false
